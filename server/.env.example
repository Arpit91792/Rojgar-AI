# ============================================================
# Rojgar AI — Backend Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/rojgar_ai_db"
# For SQLite development: DATABASE_URL="file:./prisma/dev.db"

# JWT Secrets — use long random strings in production
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_REFRESH_SECRET="change-this-to-another-long-random-secret"

# Server
PORT=5000
NODE_ENV="development"

# CORS — must match your frontend URL
CLIENT_URL="http://localhost:5173"

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Cookie settings
SESSION_COOKIE_NAME="rojgar_ai_session"
SESSION_COOKIE_SECURE="false"       # set true in production (HTTPS only)
SESSION_COOKIE_HTTPONLY="true"
SESSION_COOKIE_SAMESITE="Lax"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# Admin seed credentials
# Used ONLY by prisma/seed.js to create the admin account.
# Never exposed to frontend. Never logged. Never returned by any API.
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="your-secure-admin-password"
ADMIN_NAME="Admin"
